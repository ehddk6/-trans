{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "translation-forensics/pilot-adjudication-record/v1",
  "title": "SSIS-908 final block adjudication record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name", "schema_version", "title_id", "block_number",
    "adjudication_status", "reviewer_ids", "direct_listening_completed_by",
    "semantic_gate", "context_gate", "naturalness_outcome", "nonverbal",
    "mqm_errors", "consensus_recorded", "internal_key_unsealed_for_adjudication",
    "human_reviewed", "reason"
  ],
  "properties": {
    "schema_name": {"const": "translation-forensics/pilot-adjudication-record"},
    "schema_version": {"const": "1"},
    "title_id": {"const": "SSIS-908"},
    "block_number": {"type": "integer", "minimum": 1, "maximum": 298},
    "timecode": {"type": "string", "minLength": 1},
    "adjudication_status": {"enum": ["agreed", "adjudicated", "unresolved"]},
    "reviewer_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true, "maxItems": 2},
    "direct_listening_completed_by": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true, "maxItems": 2},
    "semantic_gate": {"enum": ["both-pass", "baseline-only", "improvement-only", "both-fail", "unresolved", "nonverbal"]},
    "context_gate": {"enum": ["both-pass", "baseline-only", "improvement-only", "both-fail", "unresolved", "nonverbal"]},
    "naturalness_outcome": {"enum": ["baseline", "improvement", "tie", "unresolved", "nonverbal"]},
    "nonverbal": {"type": ["boolean", "null"]},
    "mqm_errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate", "dimension", "severity", "error_type", "detail", "evidence_refs"],
        "properties": {
          "candidate": {"enum": ["baseline", "improvement"]},
          "dimension": {"enum": ["semantic_fidelity", "contextual_consistency", "natural_korean"]},
          "severity": {"enum": ["critical", "major", "minor"]},
          "error_type": {"type": "string", "minLength": 1},
          "detail": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "consensus_recorded": {"type": "boolean"},
    "internal_key_unsealed_for_adjudication": {"type": "boolean"},
    "human_reviewed": {"type": "boolean"},
    "reason": {"type": "string", "minLength": 1}
  }
}
