{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "translation-forensics/dialogue-scene-v2",
  "title": "Dialogue scene v2 JSONL row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "scene_id", "unit_ids", "start", "end",
    "boundary_before", "boundary_after", "boundary_evidence",
    "speaker_candidates", "source_evidence_refs"
  ],
  "properties": {
    "schema_version": {"const": "scene-v2"},
    "scene_id": {"type": "string", "minLength": 1},
    "unit_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "start": {"type": "number", "minimum": 0},
    "end": {"type": "number", "exclusiveMinimum": 0},
    "boundary_before": {"type": "string", "minLength": 1},
    "boundary_after": {"type": "string", "minLength": 1},
    "boundary_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "speaker_candidates": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "source_evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}
