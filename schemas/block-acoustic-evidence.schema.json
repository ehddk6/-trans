{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "translation-forensics/block-acoustic-evidence/v1",
  "type": "object",
  "required": ["schema_name", "schema_version", "block_number", "start", "end", "transcripts", "evidence_refs", "independent_source_families", "block_alignment_status"],
  "properties": {
    "schema_name": {"const": "translation-forensics/block-acoustic-evidence"},
    "schema_version": {"const": "1"},
    "block_number": {"type": "integer", "minimum": 1},
    "start": {"type": "string"},
    "end": {"type": "string"},
    "transcripts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["window_id", "source_family", "model", "text", "audio_sha256", "alignment_scope", "block_aligned"],
        "properties": {
          "window_id": {"type": "string"},
          "source_family": {"enum": ["faster-whisper-large-v3", "reazonspeech-k2-v2"]},
          "model": {"type": "string"},
          "text": {"type": "string", "minLength": 1},
          "audio_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "clip_start_seconds": {"type": "number", "minimum": 0},
          "clip_end_seconds": {"type": "number", "minimum": 0},
          "alignment_scope": {"enum": ["overlapping-window", "boundary-expanded-window-rerun", "utterance-timestamp"]},
          "block_aligned": {"type": "boolean"},
          "utterance_id": {"type": "string"},
          "start_seconds": {"type": "number", "minimum": 0},
          "end_seconds": {"type": "number", "minimum": 0},
          "alignment_method": {"type": "string"},
          "alignment_confidence": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "anyOf": [
          {"required": ["clip_start_seconds", "clip_end_seconds"]},
          {"required": ["start_seconds", "end_seconds", "utterance_id"]}
        ]
      }
    },
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "independent_source_families": {"type": "array", "items": {"enum": ["faster-whisper-large-v3", "reazonspeech-k2-v2"]}, "uniqueItems": true},
    "block_alignment_status": {"enum": ["window-context-only", "boundary-expanded-window-rerun", "utterance-timestamp-aligned", "no-acoustic-evidence"]},
    "asr_rerun_count": {"type": "integer", "minimum": 0, "maximum": 1},
    "external_transfer": {"const": false}
  },
  "additionalProperties": false
}
