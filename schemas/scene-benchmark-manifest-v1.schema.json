{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "translation-forensics/scene-benchmark-manifest/v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_name", "schema_version", "benchmark_id", "created_at", "scene_ids", "candidate_systems", "external_baseline_status", "evaluation_status", "human_evaluation_claimed", "note"],
  "properties": {
    "schema_name": {"const": "translation-forensics/scene-benchmark-manifest"}, "schema_version": {"const": "1"}, "benchmark_id": {"type": "string", "minLength": 1}, "created_at": {"type": "string", "minLength": 1},
    "scene_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "candidate_systems": {"type": "object", "additionalProperties": false, "required": ["candidate-a", "candidate-b", "candidate-c"], "properties": {"candidate-a": {"const": "block_v1"}, "candidate-b": {"const": "external_baseline"}, "candidate-c": {"const": "scene_v2"}}},
    "external_baseline_status": {"enum": ["not-supplied", "supplied"]}, "evaluation_status": {"const": "not-evaluated"}, "human_evaluation_claimed": {"const": false}, "note": {"type": "string", "minLength": 1}
  }
}
