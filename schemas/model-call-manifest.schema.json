{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "translation-forensics/model-call-manifest/v1",
  "title": "Model call manifest record v1",
  "type": "object",
  "required": ["schema_name", "schema_version", "title_id", "call_kind", "provider", "model", "request_id", "request_sha256", "response_sha256", "evidence_sha256", "model_settings_sha256", "environment", "environment_sha256", "cache_key", "cache_hit", "cost_usd", "external_transfer", "store", "tools_enabled"],
  "properties": {
    "schema_name": {"const": "translation-forensics/model-call-manifest"},
    "schema_version": {"const": "1"},
    "title_id": {"type": "string", "minLength": 1},
    "call_kind": {"enum": ["translation-generation", "semantic-critique", "cloud-asr"]},
    "provider": {"const": "openai"},
    "model": {"enum": ["gpt-5.6-terra", "gpt-5.6-sol", "gpt-4o-transcribe"]},
    "request_id": {"type": "string", "minLength": 1},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "response_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_settings_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "environment": {"type": "object"},
    "environment_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cache_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cache_hit": {"type": "boolean"},
    "cost_usd": {"type": "number", "minimum": 0},
    "external_transfer": {"type": "boolean"},
    "cache_origin_external_transfer": {"type": "boolean"},
    "store": {"const": false},
    "tools_enabled": {"const": false}
  }
}
