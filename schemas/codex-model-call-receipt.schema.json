{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "translation-forensics/codex-model-call-receipt/v1",
  "type": "object",
  "required": [
    "schema_name", "schema_version", "status", "title_id", "call_id", "role",
    "provider", "execution_mode", "requested_model", "reasoning_effort",
    "codex_cli_version", "thread_id", "request_sha256", "prompt_sha256",
    "evidence_sha256", "schema_sha256", "response_sha256", "input_tokens",
    "output_tokens", "exit_code", "sandbox", "ephemeral",
    "isolated_temporary_directory", "api_key_used", "authentication",
    "requested_model_verified_by_cli_invocation", "actual_server_model_reported_by_cli",
    "model_call_verified", "cache_hit"
  ],
  "properties": {
    "schema_name": {"const": "translation-forensics/codex-model-call-receipt"},
    "schema_version": {"const": "1"},
    "status": {"const": "succeeded"},
    "title_id": {"type": "string", "minLength": 1},
    "call_id": {"type": "string", "minLength": 1},
    "role": {"enum": ["meaning-frame-terra", "meaning-frame-sol", "translation-terra", "critique-sol", "repair-terra", "proxy-evaluator-terra", "proxy-evaluator-sol"]},
    "provider": {"const": "codex-cli"},
    "execution_mode": {"const": "codex-exec-ephemeral"},
    "requested_model": {"enum": ["gpt-5.6-terra", "gpt-5.6-sol"]},
    "reasoning_effort": {"enum": ["high", "xhigh"]},
    "codex_cli_version": {"type": "string", "minLength": 1},
    "thread_id": {"type": "string", "minLength": 1},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "response_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "exit_code": {"const": 0},
    "sandbox": {"const": "read-only"},
    "ephemeral": {"const": true},
    "isolated_temporary_directory": {"const": true},
    "api_key_used": {"const": false},
    "authentication": {"const": "codex-login"},
    "requested_model_verified_by_cli_invocation": {"const": true},
    "actual_server_model_reported_by_cli": {"const": false},
    "model_call_verified": {"const": true},
    "cache_hit": {"type": "boolean"}
  },
  "additionalProperties": true
}
