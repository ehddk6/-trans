{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "translation-forensics/scene-deterministic-qa-v1",
  "title": "Scene deterministic QA report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "machine_status", "scenes_checked", "units_checked", "issues"],
  "properties": {
    "status": {"enum": ["passed", "review", "failed"]},
    "machine_status": {"enum": ["machine-verified", "machine-uncertain"]},
    "scenes_checked": {"type": "integer", "minimum": 0},
    "units_checked": {"type": "integer", "minimum": 0},
    "issues": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["scene_id", "unit_ids", "category", "severity", "reason", "deterministic"],
        "properties": {
          "scene_id": {"type": "string", "minLength": 1},
          "unit_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "category": {"type": "string", "minLength": 1},
          "severity": {"enum": ["error", "review", "warning"]},
          "reason": {"type": "string", "minLength": 1},
          "deterministic": {"type": "boolean"}
        }
      }
    }
  }
}
